# Local development only. Copy this file to .env, fill in the replacement key,
# and keep .env untracked. Never put this value in browser code or VITE_* vars.
# For production, inject the secret through the deployment platform's secret
# manager instead of creating a file in the application directory.

# Required for the AI tutor. If omitted, the desktop still works and the tutor
# explains that server-side AI is not configured.
OPENAI_API_KEY=

# Optional. Any chat model with tool calling works.
OPENAI_MODEL=gpt-4.1-mini
# Linux defaults to the cost-sensitive GPT-5.6 Luna model; override it here if needed.
OPENAI_MODEL_LINUX=gpt-5.6-luna
# Other learning modules fall back to OPENAI_MODEL when their optional override is omitted.
OPENAI_MODEL_DOCKER=gpt-4.1-mini
OPENAI_MODEL_TERMINAL=gpt-4.1-mini
OPENAI_MODEL_CHMOD_ARCADE=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. The API server's port (the web dev server forwards /api here) and a per-client request limit.
PORT=8787
TUTOR_REQUESTS_PER_MINUTE=30

# Optional. A Unix socket to listen on instead of PORT (production: /run/tuxos/api.sock, behind Caddy), the TCP
# address to listen on, and whether to trust the
# reverse proxy's client-IP header (Cloudflare's CF-Connecting-IP) for rate limiting. Only set TRUST_PROXY=1
# when the API is reachable solely through that proxy.
# SOCKET=/run/tuxos/api.sock
# HOST=127.0.0.1
# TRUST_PROXY=1

# Accounts and saved progress (SQLite; production: /var/lib/tuxos/tuxos.db). Sign-in attempts allowed per minute per
# visitor. COOKIE_SECURE=0 only for plain-http hosts other than localhost.
# DATABASE_PATH=data/tuxos.db
# AUTH_ATTEMPTS_PER_MINUTE=10
# COOKIE_SECURE=1
