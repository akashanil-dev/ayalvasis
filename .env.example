# Copy to .env and fill in. Never commit .env: it is ignored by git.

# Needed for the AI tutor. Without it the desktop works and the tutor explains that it isn't set up.
OPENAI_API_KEY=

# Optional. Any chat model with tool calling works.
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. The API server's port (the web dev server forwards /api here) and a per-client request limit.
PORT=8787
TUTOR_REQUESTS_PER_MINUTE=30
