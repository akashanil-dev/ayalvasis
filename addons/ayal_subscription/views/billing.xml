<odoo>
<record id="period_list" model="ir.ui.view"><field name="name">billing.period.list</field><field name="model">ayal.billing.period</field><field name="arch" type="xml"><list create="false" delete="false"><field name="subscription_id"/><field name="start_date"/><field name="end_date"/><field name="invoice_id"/><field name="discount_id"/><field name="reservation"/><button name="action_open_invoice" type="object" string="Open invoice"/><button name="action_reissue" type="object" string="Reissue cancelled" groups="ayal_subscription.group_finance" confirm="Create a replacement for this cancelled invoice?"/></list></field></record>
<record id="periods_action" model="ir.actions.act_window"><field name="name">Billing periods</field><field name="res_model">ayal.billing.period</field><field name="view_mode">list,form</field></record>
<record id="invoices_action" model="ir.actions.act_window"><field name="name">Subscription invoices</field><field name="res_model">account.move</field><field name="view_mode">list,form</field><field name="domain">[('ayal_period_id','!=',False)]</field><field name="context">{'default_move_type':'out_invoice', 'create':False}</field></record>
<record id="payment_register_form" model="ir.ui.view"><field name="name">subscription.payment.register</field><field name="model">account.payment.register</field><field name="inherit_id" ref="account.view_account_payment_register_form"/><field name="arch" type="xml"><field name="communication" position="after"><field name="ayal_reference"/><field name="ayal_request_key" invisible="1"/></field></field></record></odoo>