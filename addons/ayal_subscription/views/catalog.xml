<odoo>
<record id="plan_list" model="ir.ui.view"><field name="name">subscription.plan.list</field><field name="model">ayal.subscription.plan</field><field name="arch" type="xml"><list><field name="name"/><field name="code"/><field name="cadence"/><field name="price"/><field name="currency_id" column_invisible="True"/><field name="active"/></list></field></record>
<record id="plan_form" model="ir.ui.view"><field name="name">subscription.plan.form</field><field name="model">ayal.subscription.plan</field><field name="arch" type="xml"><form><sheet><group><group><field name="name"/><field name="code"/><field name="product_id"/><field name="cadence"/><field name="price"/><field name="min_quantity"/></group><group><field name="company_id" groups="base.group_multi_company"/><field name="currency_id" invisible="1"/><field name="active"/><field name="available_from"/><field name="available_until"/><field name="allow_pause"/><field name="allow_close"/><field name="allow_renew"/><field name="auto_close"/><field name="auto_post"/></group></group><field name="description"/><field name="line_ids"><list editable="bottom"><field name="product_id"/><field name="quantity"/><field name="price_unit"/><field name="currency_id" column_invisible="True"/></list></field></sheet><chatter/></form></field></record>
<record id="plans_action" model="ir.actions.act_window"><field name="name">Plans</field><field name="res_model">ayal.subscription.plan</field><field name="view_mode">list,form</field></record>
<record id="discount_form" model="ir.ui.view"><field name="name">subscription.discount.form</field><field name="model">ayal.subscription.discount</field><field name="arch" type="xml"><form><sheet><group><group><field name="name"/><field name="active"/><field name="priority"/><field name="kind"/><field name="value"/><field name="currency_id" invisible="1"/></group><group><field name="date_from"/><field name="date_until"/><field name="min_amount"/><field name="min_quantity"/><field name="usage_limit"/><field name="company_id" groups="base.group_multi_company"/></group></group><group><field name="product_ids" widget="many2many_tags"/><field name="subscription_ids" widget="many2many_tags"/></group></sheet></form></field></record>
<record id="discounts_action" model="ir.actions.act_window"><field name="name">Discounts</field><field name="res_model">ayal.subscription.discount</field><field name="view_mode">list,form</field></record>
<record id="template_form" model="ir.ui.view"><field name="name">subscription.template.form</field><field name="model">ayal.subscription.template</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="active"/><field name="plan_id"/><field name="validity_days"/><field name="company_id" groups="base.group_multi_company"/></group><field name="terms"/><p>The plan supplies the primary recurring product. These lines add optional recurring products.</p><field name="line_ids"><list editable="bottom"><field name="product_id"/><field name="quantity"/><field name="price_unit"/><field name="currency_id" column_invisible="True"/></list></field></sheet></form></field></record>
