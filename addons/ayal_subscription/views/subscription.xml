<odoo>
<record id="subscription_list" model="ir.ui.view"><field name="name">subscription.list</field><field name="model">ayal.subscription</field><field name="arch" type="xml"><list decoration-muted="state == 'closed'"><field name="name"/><field name="partner_id"/><field name="plan_id"/><field name="start_date"/><field name="expiry_date"/><field name="next_billing_date"/><field name="amount_total"/><field name="currency_id" column_invisible="True"/><field name="state" widget="badge"/><field name="awaiting_close" optional="hide"/></list></field></record>
<record id="subscription_form" model="ir.ui.view"><field name="name">subscription.form</field><field name="model">ayal.subscription</field><field name="arch" type="xml"><form>
<header><button name="action_quote" type="object" string="Create quotation" class="btn-primary" invisible="state != 'draft'"/><button name="action_send_quote" type="object" string="Send quotation" invisible="state != 'quotation'"/><button name="action_confirm" type="object" string="Accept quotation" class="btn-primary" invisible="state != 'quotation'"/><button name="action_activate" type="object" string="Activate" invisible="state != 'confirmed'"/><button name="action_bill" type="object" string="Generate due invoices" invisible="state not in ('confirmed','active')"/><button name="action_pause" type="object" string="Pause" invisible="state != 'active' or pending_action" confirm="Pause at the next billing boundary?"/><button name="action_resume" type="object" string="Resume" invisible="state != 'paused'"/><button name="action_close" type="object" string="Close" invisible="state not in ('active','confirmed','paused') or pending_action" confirm="Schedule closure at the next billing boundary?"/><button name="action_amend" type="object" string="Schedule quantity change" groups="ayal_subscription.group_admin" invisible="state not in ('confirmed','active')"/><button name="action_renew" type="object" string="Renew" invisible="state in ('draft','quotation')"/><field name="state" widget="statusbar" statusbar_visible="draft,quotation,confirmed,active,closed"/></header>
<sheet><h1><field name="name"/></h1><group><group><field name="partner_id" readonly="state not in ('draft','quotation')"/><field name="template_id" readonly="state not in ('draft','quotation')"/><field name="plan_id" readonly="state not in ('draft','quotation')"/><field name="company_id" groups="base.group_multi_company" readonly="state not in ('draft','quotation')"/><field name="currency_id" invisible="1"/></group><group><field name="start_date" readonly="state not in ('draft','quotation')"/><field name="expiry_date" readonly="state not in ('draft','quotation')"/><field name="payment_term_id" readonly="state not in ('draft','quotation')"/><field name="catchup_preview" invisible="not catchup_preview"/><field name="backdate_reason" groups="ayal_subscription.group_admin" readonly="state not in ('draft','quotation')"/><field name="quote_valid_until" readonly="state not in ('draft','quotation')"/><field name="next_billing_date"/><field name="pending_action"/><field name="effective_date"/><field name="awaiting_close"/><field name="billing_error" invisible="not billing_error"/><field name="retry_after" invisible="not retry_after"/></group></group>
<notebook><page string="Recurring products"><field name="line_ids" readonly="state not in ('draft','quotation')"><list editable="bottom"><field name="product_id"/><field name="name" optional="hide"/><field name="quantity"/><field name="price_unit"/><field name="tax_ids" widget="many2many_tags" domain="[('type_tax_use','=','sale')]"/><field name="currency_id" column_invisible="True"/></list></field><group class="oe_subtotal_footer"><field name="amount_untaxed"/><field name="amount_tax"/><field name="amount_total"/></group></page>
<page string="Terms"><field name="terms" readonly="state not in ('draft','quotation')"/><field name="order_id"/><field name="predecessor_id"/><field name="snapshot_hash"/></page><page string="Billing history"><field name="period_ids" readonly="1"><list create="false" delete="false"><field name="start_date"/><field name="end_date"/><field name="invoice_id"/><field name="discount_amount"/><field name="reservation"/><button name="action_open_invoice" type="object" string="Open invoice"/></list></field></page><page string="Amendments"><field name="amendment_ids" readonly="1"><list create="false" delete="false"><field name="effective_date"/><field name="line_id"/><field name="quantity"/><field name="reason"/><field name="state"/><button name="action_cancel" type="object" string="Cancel" groups="ayal_subscription.group_admin" invisible="state != 'pending'"/></list></field></page><page string="Activity"><field name="event_ids" readonly="1"><list create="false" delete="false"><field name="create_date"/><field name="actor_id"/><field name="action"/><field name="detail"/></list></field></page></notebook></sheet><chatter/></form></field></record>
<record id="subscriptions_action" model="ir.actions.act_window"><field name="name">Subscriptions</field><field name="res_model">ayal.subscription</field><field name="view_mode">list,form</field></record>
<record id="amend_form" model="ir.ui.view"><field name="name">subscription.amend.form</field><field name="model">ayal.subscription.amend</field><field name="arch" type="xml"><form string="Schedule quantity change"><group><field name="subscription_id" readonly="1"/><field name="line_id"/><field name="quantity"/><field name="effective_date"/><field name="reason"/></group><footer><button name="action_schedule" type="object" string="Schedule amendment" class="btn-primary"/><button string="Cancel" special="cancel"/></footer></form></field></record></odoo>