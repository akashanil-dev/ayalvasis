<odoo>
<record id="action_report_contract" model="ir.actions.report"><field name="name">Subscription agreement</field><field name="model">ayal.subscription</field><field name="report_type">qweb-pdf</field><field name="report_name">ayal_subscription.report_contract</field><field name="report_file">ayal_subscription.report_contract</field><field name="binding_model_id" ref="model_ayal_subscription"/><field name="binding_type">report</field></record>
<template id="report_contract"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><h2><span t-field="o.name"/> · Subscription agreement</h2><p><strong>Customer: </strong><span t-field="o.partner_id.name"/></p><p><strong>Plan: </strong><span t-esc="o.snapshot.get('plan_name', o.plan_id.name) if o.snapshot else o.plan_id.name"/></p><p><strong>Service: </strong><span t-field="o.start_date"/> through <span t-field="o.expiry_date"/></p><p><strong>Quotation valid through: </strong><span t-field="o.quote_valid_until"/></p><table class="table table-sm"><thead><tr><th>Recurring product</th><th>Quantity</th><th>Unit price</th><th>Taxes</th></tr></thead><tbody><tr t-foreach="o.line_ids" t-as="line"><td><span t-field="line.name"/></td><td><span t-field="line.quantity"/></td><td><span t-field="line.price_unit"/></td><td t-esc="', '.join(line.tax_ids.mapped('name'))"/></tr></tbody></table><div class="text-end"><p>Untaxed: <span t-field="o.amount_untaxed"/></p><p>Tax: <span t-field="o.amount_tax"/></p><p><strong>Total per period: <span t-field="o.amount_total"/></strong></p></div><h3>Terms</h3><p style="white-space:pre-wrap" t-esc="o.terms or 'No additional terms.'"/><p>Billing is in advance. The final partial period is prorated by service days. Pauses and closures take effect at a billing boundary. Existing invoices remain payable.</p></div></t></t></t></template>
<template id="invoice_discount_precision" inherit_id="account.report_invoice_document"><xpath expr="//span[@t-field='line.discount']" position="replace"><span class="text-nowrap" t-esc="('%.8f' % line.discount).rstrip('0').rstrip('.')"/></xpath></template></odoo>
