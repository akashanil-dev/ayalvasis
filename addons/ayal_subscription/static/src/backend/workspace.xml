<templates xml:space="preserve"><t t-name="ayal_subscription.Workspace">
<div class="ayal-workspace h-100 overflow-auto"><header class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><p class="ayal-eyebrow">AYALVASIS · OPERATIONS</p><h1>Subscriptions</h1><p class="text-muted mb-0">Manage recurring services, customer agreements and billing.</p></div><div class="d-flex gap-2"><button class="btn btn-outline-primary" t-on-click="billing">Billing history</button><button class="btn btn-primary" t-on-click="create">New subscription</button></div></header>
<section class="ayal-metrics" aria-label="Subscription metrics"><div class="ayal-card"><span>Active subscriptions</span><strong t-esc="state.metrics.active || 0"/></div><div t-if="state.finance" class="ayal-card"><span>Posted invoices · company currency</span><strong t-esc="(state.metrics.invoiced || 0).toLocaleString()"/></div><div t-if="state.finance" class="ayal-card"><span>Outstanding</span><strong t-esc="(state.metrics.outstanding || 0).toLocaleString()"/></div><div t-if="state.finance" class="ayal-card"><span>Overdue</span><strong t-esc="(state.metrics.overdue || 0).toLocaleString()"/></div><div t-if="state.finance" class="ayal-card"><span>Reconciled receipts</span><strong t-esc="(state.metrics.cash || 0).toLocaleString()"/></div></section><form t-if="state.finance" class="d-flex flex-wrap gap-2 align-items-end mt-3" t-on-submit.prevent="load"><label>Financial dates from<input type="date" class="form-control" t-model="state.dateFrom"/></label><label>Through<input type="date" class="form-control" t-model="state.dateUntil"/></label><button class="btn btn-outline-secondary" type="submit">Apply dates</button><span class="text-muted" t-esc="'Amounts in ' + state.currency"/></form>
<div t-if="state.metrics.failed" class="alert alert-warning mt-3" role="status"><t t-esc="state.metrics.failed"/> subscriptions have billing errors. Open Contracts and inspect the billing error before retrying.</div><form class="d-flex flex-wrap gap-2 my-4" t-on-submit.prevent="search"><label class="visually-hidden" for="ayal-search">Search subscriptions</label><input id="ayal-search" class="form-control ayal-search" t-model="state.query" placeholder="Search customer or subscription…"/><label class="visually-hidden" for="ayal-state">Status</label><select id="ayal-state" class="form-select w-auto" t-model="state.filter" t-on-change="search"><option value="">All statuses</option><option value="draft">Draft</option><option value="quotation">Quotation</option><option value="confirmed">Confirmed</option><option value="active">Active</option><option value="paused">Paused</option><option value="closed">Closed</option></select><button class="btn btn-outline-secondary" type="submit">Search</button></form>
<div t-if="state.error" class="alert alert-danger" role="alert"><t t-esc="state.error"/> <button class="btn btn-link" t-on-click="load">Retry</button></div><p t-if="state.loading" role="status">Loading subscriptions…</p>
<div t-else="" class="ayal-card p-0 table-responsive"><table class="table mb-0 align-middle"><thead><tr><th>Subscription</th><th>Customer</th><th>Plan</th><th>Status</th><th>Next billing</th><th>Per period</th></tr></thead><tbody><tr t-foreach="state.rows" t-as="row" t-key="row.id"><td><button class="btn btn-link p-0" t-on-click="() => this.open(row.id)" t-esc="row.name"/></td><td t-esc="row.customer"/><td t-esc="row.plan"/><td><span class="badge text-bg-light text-capitalize" t-esc="row.state"/></td><td t-esc="row.next || '—'"/><td><t t-esc="row.currency"/> <t t-esc="row.total.toLocaleString()"/></td></tr><tr t-if="!state.rows.length"><td colspan="6" class="text-center py-5 text-muted">No subscriptions match this view. Create a subscription to get started.</td></tr></tbody></table></div>
<footer class="d-flex justify-content-between align-items-center mt-3"><span t-esc="state.count + ' subscriptions'"/><div class="d-flex gap-2"><button class="btn btn-outline-secondary" t-att-disabled="state.page === 0 || state.loading" t-on-click="() => this.page(-1)">Previous</button><span class="align-self-center" t-esc="'Page ' + (state.page + 1)"/><button class="btn btn-outline-secondary" t-att-disabled="(state.page + 1) * 25 >= state.count || state.loading" t-on-click="() => this.page(1)">Next</button></div></footer></div>
</t></templates>
