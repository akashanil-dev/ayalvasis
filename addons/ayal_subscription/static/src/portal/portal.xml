<templates xml:space="preserve"><t t-name="ayal_subscription.Portal"><div class="ayal-portal"><p class="ayal-eyebrow">YOUR ACCOUNT</p><h1>My subscriptions</h1><p class="text-muted">Review your agreements, download invoices and manage recurring services.</p><p><a class="btn btn-outline-primary" href="/my/invoices">All invoices and credit notes</a></p>
<div t-if="state.error" class="alert alert-danger" role="alert"><t t-esc="state.error"/> <button class="btn btn-link" t-on-click="load">Retry</button></div><div t-if="state.notice" class="alert alert-success" role="status" t-esc="state.notice"/>
<section t-if="state.confirm" class="ayal-card mb-4 border-primary" role="region" aria-label="Confirm subscription action"><h2 class="h5">Confirm <t t-esc="state.confirm.action"/> · <t t-esc="state.confirm.name"/></h2><p>Accepting a quotation agrees to the displayed products, price and terms. Pauses and closures take effect at the next billing boundary; existing invoices remain payable. Renewals create a new quotation.</p><p t-if="['pause', 'close'].includes(state.confirm.action)"><strong>Effective date: <t t-esc="state.confirm.effective"/></strong></p><label t-if="state.confirm.action === 'resume'" class="d-block mb-3">Resume on<input class="form-control" type="date" t-model="state.confirm.resume_date" t-att-min="state.confirm.today" t-att-max="state.confirm.expiry"/></label><div class="d-flex gap-2"><button class="btn btn-primary" t-att-disabled="state.busy" t-on-click="execute">Confirm request</button><button class="btn btn-outline-secondary" t-att-disabled="state.busy" t-on-click="cancel">Keep current subscription</button></div></section>
<p t-if="state.loading" role="status">Loading your subscriptions…</p><p t-elif="!state.rows.length" class="ayal-card">You have no subscriptions yet. Contact our team to request a quotation.</p>
<div class="ayal-portal-grid"><article class="ayal-card" t-foreach="state.rows" t-as="row" t-key="row.id"><div class="d-flex justify-content-between gap-2"><h2 class="h4" t-esc="row.plan"/><span class="badge text-bg-light text-capitalize align-self-start" t-esc="row.state"/></div><p class="text-muted" t-esc="row.name"/><p class="fs-4"><t t-esc="row.currency"/> <t t-esc="row.total.toLocaleString()"/><small class="fs-6 text-muted"> / period</small></p><dl><dt>Service dates</dt><dd><t t-esc="row.start"/> — <t t-esc="row.expiry"/></dd><dt>Next billing</dt><dd t-esc="row.next || 'Not scheduled'"/></dl><p t-if="row.pending" class="alert alert-info"><t t-esc="row.pending"/> scheduled for <t t-esc="row.effective"/></p><p><a t-att-href="'/my/subscriptions/' + row.id + '/agreement'">Download agreement</a></p><details><summary>Products and pricing</summary><ul><li t-foreach="row.lines" t-as="line" t-key="line_index"><t t-esc="line.quantity"/> × <t t-esc="line.product"/> — <t t-esc="row.currency"/> <t t-esc="line.price"/><small class="d-block" t-esc="line.taxes || 'No tax'"/></li></ul></details><details t-if="row.terms"><summary>Contract terms</summary><p class="ayal-terms" t-esc="row.terms"/></details><div class="d-flex flex-wrap gap-2 my-3"><button t-if="row.state === 'quotation'" class="btn btn-primary" t-on-click="() => this.ask(row, 'accept')">Accept quotation</button><button t-if="row.state === 'active' &amp;&amp; row.can_pause &amp;&amp; !row.pending" class="btn btn-outline-primary" t-on-click="() => this.ask(row, 'pause')">Pause</button><button t-if="row.state === 'paused'" class="btn btn-primary" t-on-click="() => this.ask(row, 'resume')">Resume</button><button t-if="['active', 'confirmed', 'paused'].includes(row.state) &amp;&amp; row.can_close &amp;&amp; !row.pending" class="btn btn-outline-secondary" t-on-click="() => this.ask(row, 'close')">Close</button><button t-if="row.can_renew" class="btn btn-outline-primary" t-on-click="() => this.ask(row, 'renew')">Renew</button></div><details t-if="row.invoices.length"><summary>Latest invoices (<t t-esc="row.invoices.length"/>)</summary><ul class="list-unstyled"><li t-foreach="row.invoices" t-as="invoice" t-key="invoice.id" class="py-2 border-bottom"><a t-att-href="invoice.url" t-esc="invoice.name"/><span class="d-block">Total: <t t-esc="invoice.total"/> · Due: <t t-esc="invoice.due"/> · <t t-esc="invoice.status"/></span></li></ul></details></article></div>
<div class="d-flex justify-content-between mt-4"><button class="btn btn-outline-secondary" t-att-disabled="state.page === 0 || state.loading" t-on-click="() => this.page(-1)">Previous</button><span t-esc="'Page ' + (state.page + 1)"/><button class="btn btn-outline-secondary" t-att-disabled="(state.page + 1) * 12 >= state.count || state.loading" t-on-click="() => this.page(1)">Next</button></div></div></t></templates>
