<odoo>
<record id="group_staff" model="res.groups"><field name="name">Subscription Staff</field><field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('sales_team.group_sale_salesman_all_leads'))]"/></record>
<record id="group_finance" model="res.groups"><field name="name">Subscription Billing</field><field name="implied_ids" eval="[(4, ref('group_staff')), (4, ref('account.group_account_invoice'))]"/></record>
<record id="group_admin" model="res.groups"><field name="name">Subscription Administrator</field><field name="implied_ids" eval="[(4, ref('group_finance')), (4, ref('sales_team.group_sale_manager')), (4, ref('account.group_account_manager'))]"/><field name="user_ids" eval="[(4, ref('base.user_admin'))]"/></record>
</odoo>