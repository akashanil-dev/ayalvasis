[Unit]
Description=Ayalvasis consistent database and filestore backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=ayalvasis
Group=ayalvasis
WorkingDirectory=/opt/ayalvasis
UMask=0077
ExecStart=/usr/bin/python3 /opt/ayalvasis/scripts/stack.py --mode prod backup
TimeoutStartSec=30min
