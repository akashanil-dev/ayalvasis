{
	email {$ACME_EMAIL}
	admin off
}

{$DOMAIN} {
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
	}
	# Reset and portal tokens can appear in URLs: omit URIs from access logs.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri delete
			}
		}
	}
	@database path /web/database /web/database/*
	respond @database 404
	@websocket path /websocket /websocket/*
	reverse_proxy @websocket odoo:8072
	reverse_proxy odoo:8069
}
